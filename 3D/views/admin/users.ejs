<%- include('../partials/header') %>
<h1>Naudotojai</h1>
<table border="1" cellpadding="4">
  <tr><th>ID</th><th>Vardas</th><th>El. paštas</th><th>Rolė</th><th>Aktyvus</th><th>Erdvės</th><th>Rezervacijos</th><th>Veiksmai</th></tr>
  <% users.forEach(u => { %>
  <tr>
    <td><%= u.id %></td><td><%= u.full_name %></td><td><%= u.email %></td><td><%= u.role %></td>
    <td><%= u.is_active ? 'taip' : 'ne' %></td><td><%= u.venue_count %></td><td><%= u.booking_count %></td>
    <td>
      <% if (u.id !== currentUser.id) { %>
        <form method="post" action="/admin/users/<%= u.id %>/toggle-active" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit"><%= u.is_active ? 'Deaktyvuoti' : 'Aktyvuoti' %></button>
        </form>
        <a href="/admin/users/<%= u.id %>/delete">Šalinti</a>
      <% } else { %>(jūs)<% } %>
    </td>
  </tr>
  <% }) %>
</table>
<%- include('../partials/footer') %>
